rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ────────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    // Replace CdeioQnkZPdcUEqVXrkT7BTU0SD2 with your Firebase UID (Firebase Console → Auth)
    function isOwner() {
      return isAuth() && request.auth.uid == 'CdeioQnkZPdcUEqVXrkT7BTU0SD2';
    }

    function getRole() {
      return get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuth() && (isOwner() || getRole() == 'admin');
    }

    function isTeacher() {
      return isAuth() && (isOwner() || getRole() in ['admin', 'teacher']);
    }

    // ─── User Roles ──────────────────────────────────────────────────────────
    // Stores { role, displayName, email } for every user.

    match /userRoles/{uid} {
      allow get:  if isAuth() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();

      // Self-registration: only 'student' is allowed; only whitelisted fields.
      allow create: if isAuth()
        && request.auth.uid == uid
        && request.resource.data.role == 'student'
        && request.resource.data.keys().hasOnly(['role', 'displayName', 'email', 'createdAt']);

      // Owner can set any role; admins can promote/demote between teacher/student;
      // users can update only their own displayName — nothing else.
      allow update: if isOwner()
        || (isAdmin() && request.resource.data.role in ['teacher', 'student'])
        || (isAuth() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName']));

      allow delete: if isAdmin() || isOwner();
    }

    // ─── Private user data ───────────────────────────────────────────────────

    match /users/{userId} {
      allow read, write: if isAuth() && request.auth.uid == userId;

      match /progress/{topicSlug} {
        allow read, write: if isAuth() && request.auth.uid == userId;
      }

      match /quizHistory/{docId} {
        allow read, write: if isAuth() && request.auth.uid == userId;
      }

      match /meta/{docId} {
        allow read, write: if isAuth() && request.auth.uid == userId;
      }
    }

    // ─── Dynamic Lessons ─────────────────────────────────────────────────────
    // Created by admins; visible to authenticated users once published.
    // Students may only list/query published lessons (Firestore validates the
    // query filter, so a bare collection scan without the filter is rejected).

    match /dynamicLessons/{lessonId} {
      allow get:  if isAuth() && (resource.data.published == true || isAdmin());
      allow list: if isTeacher()
        || (isAuth() && resource.data.published == true);
      allow create, update, delete: if isAdmin();
    }

    // ─── Assignments ─────────────────────────────────────────────────────────
    // Teachers create assignments; admins manage all.
    // Students may only list published assignments.

    match /assignments/{assignmentId} {
      allow get: if isAuth() && (
        resource.data.published == true
        || isAdmin()
        || (isTeacher() && resource.data.teacherId == request.auth.uid)
      );
      allow list: if isTeacher()
        || (isAuth() && resource.data.published == true);
      allow create: if isTeacher()
        && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if isAdmin()
        || (isTeacher() && resource.data.teacherId == request.auth.uid);

      // ── Student submissions ───────────────────────────────────────────────
      // - Students create their own submission; cannot pre-set grading fields.
      // - Students can only read/list their own submissions.
      // - Teachers can update only grading fields; cannot overwrite answers.
      // - Only admins can delete submissions.

      match /submissions/{submissionId} {
        allow create: if isAuth()
          && request.resource.data.userId == request.auth.uid
          && !request.resource.data.keys().hasAny(['manualScore', 'gradedBy', 'feedback']);

        allow get: if isAuth() && (
          resource.data.userId == request.auth.uid || isTeacher() || isAdmin()
        );

        // resource.data.userId in list context: Firestore validates that the
        // client query is constrained to userId == request.auth.uid, so a bare
        // scan (without where filter) is rejected for students.
        allow list: if isAuth() && (
          resource.data.userId == request.auth.uid || isTeacher() || isAdmin()
        );

        // Teachers may only write grading fields; they cannot overwrite the
        // student's original answers, userId, assignmentId, or score.
        allow update: if (isTeacher() || isAdmin())
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['manualScore', 'feedback', 'gradedBy', 'gradedAt']);

        allow delete: if isAdmin();
      }
    }

    // ─── Submissions (collectionGroup) ──────────────────────────────────────
    // Needed for collectionGroup('submissions') queries on the student profile
    // page. Must mirror the per-assignment rules above.

    match /{path=**}/submissions/{submissionId} {
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && !request.resource.data.keys().hasAny(['manualScore', 'gradedBy', 'feedback']);

      allow get: if isAuth() && (
        resource.data.userId == request.auth.uid || isTeacher() || isAdmin()
      );

      allow list: if isAuth() && (
        resource.data.userId == request.auth.uid || isTeacher() || isAdmin()
      );
    }

    // ─── Teacher Profiles ────────────────────────────────────────────────────
    // Stores Google Classroom OAuth tokens — only visible to the teacher.
    // Admins may audit the doc (e.g. to revoke access) but the token value
    // should not be rendered in any admin UI.

    match /teacherProfiles/{uid} {
      allow read, write: if isAuth() && request.auth.uid == uid;
      allow get: if isAdmin();
    }

    // ─── Class Groups ────────────────────────────────────────────────────────
    // Teachers create classes; students join via invite link.
    // Anyone (including unauthenticated) may GET a specific class by ID so
    // that invite links work without requiring sign-in first.
    // Listing all classes is restricted to members, teachers, and admins.

    match /classGroups/{classId} {
      allow get: if true;

      allow list: if isAuth() && (
        resource.data.teacherId == request.auth.uid
        || exists(/databases/$(database)/documents/classGroups/$(classId)/members/$(request.auth.uid))
        || isAdmin()
      );

      allow create: if isTeacher()
        && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if isAdmin()
        || (isTeacher() && resource.data.teacherId == request.auth.uid);

      match /members/{memberId} {
        allow create: if isAuth() && request.auth.uid == memberId;

        allow read, list: if isAuth() && (
          request.auth.uid == memberId
          || get(/databases/$(database)/documents/classGroups/$(classId)).data.teacherId == request.auth.uid
          || exists(/databases/$(database)/documents/classGroups/$(classId)/members/$(request.auth.uid))
          || isAdmin()
        );

        allow delete: if isAdmin()
          || get(/databases/$(database)/documents/classGroups/$(classId)).data.teacherId == request.auth.uid;
      }
    }

    // ─── User → Class mapping ────────────────────────────────────────────────
    // Each student stores which class they belong to.

    match /userClasses/{uid} {
      allow read, write: if isAuth() && request.auth.uid == uid;
      allow get: if isAdmin();
    }

    // ─── Deny everything else ────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
