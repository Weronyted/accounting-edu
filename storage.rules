rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ─── Role helpers (read from Firestore) ──────────────────────────────────
    // firestore.get() is available in Storage Rules v2.

    function isOwner() {
      return request.auth != null
        && request.auth.uid == 'CdeioQnkZPdcUEqVXrkT7BTU0SD2';
    }

    function getRole() {
      return firestore.get(
        /databases/(default)/documents/userRoles/$(request.auth.uid)
      ).data.role;
    }

    function isTeacher() {
      return request.auth != null
        && (isOwner() || getRole() in ['admin', 'teacher']);
    }

    // ─── Lesson images ───────────────────────────────────────────────────────
    // Only teachers and admins may upload; all authenticated users may read.
    // Allowed types: common web image formats only (no SVG to reduce XSS risk).
    // Max size: 5 MB.

    match /lessons/{lessonId}/images/{filename} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
        && isTeacher()
        && request.resource.size  < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|gif|webp)');
    }

    // ─── User avatars ────────────────────────────────────────────────────────
    // Each user may upload their own avatar; authenticated users may read.
    // Max size: 2 MB.

    match /users/{uid}/avatar/{filename} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size  < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|gif|webp)');
    }

    // ─── Deny everything else ────────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
